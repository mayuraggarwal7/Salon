# Copy to .env on the server and fill in. Never commit .env.

# Your domain, pointed at the server's IP with a DNS A record (e.g. book.akssalon.in).
DOMAIN=salon.example.com

# Long random values. Generate each with:  openssl rand -base64 48 | tr -d '\n/+='
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Manager login, created or updated on every start.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

# Salon profile
SALON_NAME="Ak's"
SALON_TIME_ZONE=Asia/Kolkata
SALON_CURRENCY=₹
SALON_ADDRESS=
# true loads sample services, stylists and hours; keep false for real data.
SALON_SEED_DEMO=false

# WhatsApp Cloud API (leave blank to run in dry-run mode). See README "Connecting WhatsApp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_STAFF_ALERT_TEMPLATE=
